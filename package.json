{
  "name": "@hmilyld/create-fullstack-app",
  "version": "2.0.2",
  "description": "Scaffold a production-ready full-stack admin app with React, Vue or Svelte and FastAPI or Spring Boot.",
  "keywords": [
    "scaffolding",
    "fullstack",
    "admin-dashboard",
    "react",
    "vue",
    "svelte",
    "sveltekit",
    "java",
    "python",
    "fastapi",
    "spring-boot",
    "docker"
  ],
  "homepage": "https://fullstack.hmilyld.com",
  "bugs": {
    "url": "https://github.com/hmilyld/fullstack-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmilyld/fullstack-starter.git"
  },
  "author": "hmilyld",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "create-fullstack-app": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src scripts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "sync:permissions": "tsx scripts/sync-permission-docs.ts",
    "sync:permissions:check": "tsx scripts/sync-permission-docs.ts --check",
    "sync:permissions:catalog": "tsx scripts/sync-permission-docs.ts --catalog-only",
    "sync:design:check": "tsx scripts/check-design-sync.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^4.1.2",
    "ejs": "^3.1.10",
    "fs-extra": "^11.2.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
