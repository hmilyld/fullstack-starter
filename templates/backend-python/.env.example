# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db

# JWT
# 必须设置为强随机密钥，否则服务启动会拒绝。生成方式: openssl rand -base64 48
# 本地开发可依赖 dev.sh 自动生成随机密钥；如需固定密钥，请取消注释并填入强随机值
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]
